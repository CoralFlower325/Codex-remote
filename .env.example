# Canonical public URL used for link generation and origin checks.
# Keep empty during local development. The first PUBLIC_ORIGINS entry is used when empty.
PUBLIC_ORIGIN=

# Local listener. Cloudflare Tunnel or a self-hosted HTTPS reverse proxy should
# connect to this address.
HOST=127.0.0.1
PORT=4545

# Optional secondary HTTPS listener for a trusted LAN/VPN. 0 disables it.
# Configure with npm run setup:lan -- --cert <file.pem> --key <file.pem>.
LAN_PORT=0
LAN_CERT_FILE=
LAN_KEY_FILE=
# Explicit plaintext opt-in; set only after accepting unencrypted LAN traffic.
# npm run setup:lan -- --allow-http sets this to 1.
LAN_ALLOW_HTTP=0
# Optional preferred local IPv4 address shown in the connection menu.
LAN_ADDRESS=

# Optional explicit path to the Codex desktop bundled CLI.
# Leave empty to auto-detect the supported Codex / ChatGPT installation.
CODEX_BINARY=

# Optional Codex home. Defaults to the current user's ~/.codex.
CODEX_HOME=

# Optional working directory used by new threads when no project is selected.
CODEX_WORKDIR=

# Optional preferred local Chromium DevTools port. Windows and macOS Remote also
# discover the loopback port from the current installed Codex/ChatGPT process.
# Explicit comma-separated candidates are tried alongside the standard 9229 fallback.
CODEX_DESKTOP_DEBUG_PORT=

# Optional comma-separated public origins shown in the connection menu. They are
# trusted in addition to the canonical origin.
PUBLIC_ORIGINS=

# Optional comma-separated origin trust list. PUBLIC_ORIGIN and PUBLIC_ORIGINS
# are always included. Use this for origins that pair with a reverse proxy.
ALLOWED_ORIGINS=

# 1 (default) trusts loopback proxies only; 0 disables proxy trust.
# For non-loopback reverse proxies, specify their trusted IPs/CIDRs, comma-separated.
TRUST_PROXY=1

# Optional host-side Office preview converter. Leave empty for standard-install detection.
# Install LibreOffice separately; it is not included in Remote runtime packages.
LIBREOFFICE_PATH=

# Session lifetime in days.
SESSION_DAYS=7

# Inactivity limit in hours.
SESSION_IDLE_HOURS=24
