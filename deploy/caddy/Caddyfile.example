# Replace codex.example.com, /srv/codex-remote/current and the tunnel port.
codex.example.com {
	encode zstd gzip

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy same-origin
	}

	@private path /api /api/* /ws /ws/* /health
	handle @private {
		reverse_proxy 127.0.0.1:14545 {
			flush_interval -1
		}
	}

	@assets path /assets/*
	handle @assets {
		root * /srv/codex-remote/current
		header Cache-Control "public, max-age=31536000, immutable"
		file_server {
			precompressed br
		}
	}

	handle {
		root * /srv/codex-remote/current
		header Cache-Control no-cache
		try_files {path} /index.html
		file_server {
			precompressed br
		}
	}

	handle_errors {
		header Cache-Control no-store
		respond "{err.status_code}" {err.status_code}
	}
}
