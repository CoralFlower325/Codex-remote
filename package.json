{
  "name": "codex-remote",
  "version": "0.1.9",
  "private": true,
  "type": "module",
  "description": "Responsive remote control UI for the Codex desktop app.",
  "license": "MIT",
  "author": "CoralFlower325",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/CoralFlower325/Codex-remote.git"
  },
  "homepage": "https://github.com/CoralFlower325/Codex-remote#readme",
  "bugs": {
    "url": "https://github.com/CoralFlower325/Codex-remote/issues"
  },
  "scripts": {
    "postinstall": "node scripts/prepare-terminal.mjs",
    "dev": "concurrently -k -n server,web -c cyan,magenta \"tsx watch src/server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc -p tsconfig.server.json && tsc -p tsconfig.client.json && vite build",
    "prepare:edge": "node scripts/prepare-edge.mjs",
    "setup:lan": "node scripts/enable-lan.mjs",
    "deploy:edge": "npm run build && npm run prepare:edge && cf deploy --prebuilt",
    "start": "node dist-server/server/index.js",
    "set-password": "tsx src/server/cli/set-password.ts",
    "setup:macos": "bash scripts/setup-macos.sh",
    "start:macos": "bash scripts/remote-control-macos.sh Start",
    "stop:macos": "bash scripts/remote-control-macos.sh Stop",
    "status:macos": "bash scripts/remote-control-macos.sh Status",
    "install-service:macos": "bash scripts/install-service.sh",
    "uninstall-service:macos": "bash scripts/remote-control-macos.sh Uninstall",
    "setup:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/setup-windows.ps1",
    "install-task:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-task-windows.ps1",
    "uninstall-task:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/install-task-windows.ps1 -Unregister",
    "tunnel:windows": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File scripts/cloudflared-tunnel-windows.ps1",
    "typecheck": "tsc -p tsconfig.server.json --noEmit && tsc -p tsconfig.client.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "dependencies": {
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-serialize": "^0.14.0",
    "@xterm/headless": "^6.0.0",
    "@xterm/xterm": "^6.0.0",
    "compression": "^1.8.2",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "highlight.js": "^11.12.0",
    "lucide-react": "^0.468.0",
    "node-pty": "^1.1.0",
    "pdfjs-dist": "^6.4.299",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "uuid": "^13.0.2",
    "web-push": "^3.6.7",
    "ws": "^8.21.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/web-push": "^3.6.4",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vite": "^6.0.6",
    "vitest": "^5.0.5"
  }
}
